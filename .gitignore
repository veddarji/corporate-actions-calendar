# .gitignore for Corporate Actions Platform

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ─── Java / Maven ─────────────────────────────────────────────────────────────
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
!backend/.mvn/wrapper/maven-wrapper.properties
*.class
*.jar
*.war
*.ear

# ─── Node / NPM ───────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── IDE ──────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
.DS_Store

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore override files
docker-compose.override.yml

# ─── AWS ──────────────────────────────────────────────────────────────────────
.aws/
*.pem
*.p12
*.pfx

# ─── Test coverage ────────────────────────────────────────────────────────────
coverage/
*.lcov
